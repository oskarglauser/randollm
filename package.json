{
  "name": "randollm",
  "version": "1.0.0",
  "description": "Real randomness for LLMs: a remote MCP server, REST API and landing page on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --port 3002",
    "build:site": "esbuild site/die.js --bundle --minify --format=esm --target=es2022 --outfile=public/assets/die.js --log-level=warning",
    "deploy": "wrangler deploy",
    "mcp": "node src/mcp.js",
    "test": "node --test \"test/*.test.js\"",
    "plugin:zip": "rm -f dist/randollm-chatgpt.zip && mkdir -p dist && cd chatgpt-plugin && zip -rX ../dist/randollm-chatgpt.zip . -x '.*'",
    "usage": "node scripts/usage.mjs",
    "promo": "node promo/serve.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "randomness",
    "random",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "randollm-mcp": "src/mcp.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mediabunny": "^1.62.0",
    "three": "^0.186.1",
    "wrangler": "^4.151.3"
  },
  "private": true,
  "homepage": "https://randollm.glauser.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskarglauser/randollm.git"
  },
  "bugs": {
    "url": "https://github.com/oskarglauser/randollm/issues"
  }
}
