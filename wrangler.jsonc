{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Remote MCP server + REST API + static landing page on one Worker.
  // Workers Builds deploys every push to the production branch; other
  // branches get a Preview URL (workers.dev, noindex).
  "name": "randollm",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  // node:crypto (HMAC, randomBytes) for src/random.js.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Only these paths run the Worker. Everything else is a static asset:
    // free, unlimited, and doesn't count toward the daily request limit.
    // Every request runs the Worker so it can report AI agents to Appscope.
    "run_worker_first": true
  },
  "vars": {
    "APP_URL": "https://randollm.glauser.com"
  },
  // Per IP, per Cloudflare location. Claude and ChatGPT call remote MCP
  // servers from shared IPs, so the MCP limit is deliberately high.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "4202", "simple": { "limit": 600, "period": 60 } }
  ],
  // Anonymous usage counts (see src/usage.js); query with scripts/usage.mjs.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "randollm_usage" }],
  "observability": { "enabled": true },
  // Served on randollm.glauser.com: a custom domain attached to this Worker in
  // Cloudflare (not declared here, so builds don't need permission to manage
  // domains).
  "workers_dev": false,
  "preview_urls": true
}
