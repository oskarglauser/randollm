# Copy to .dev.vars for `wrangler dev`. In production, set secrets with
# `npx wrangler secret put <NAME>` or in the Cloudflare dashboard.
# APP_URL is a plain var in wrangler.jsonc.

# Optional. When set, every result is HMAC-signed and /api/verify can check it.
RANDOLLM_SECRET=

# Only for `npm run usage` on your machine (not used by the Worker).
# Token: Cloudflare dashboard → My Profile → API Tokens → Create Custom Token,
# permission Account → Account Analytics → Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
